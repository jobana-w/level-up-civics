---
title: Home
---
{% extends "layouts/base.njk" %}

{% block head %}
<style>
  /* ── HERO ──────────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 55% 45%;
    padding-top: 64px;
  }
  .hero-content {
    display: flex; flex-direction: column; justify-content: center;
    padding: 60px 72px 60px 80px;
    background: var(--cream);
  }
  .hero-visual { overflow: hidden; position: relative; }
  .hero-visual img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center top;
    display: block;
  }
  .hero-h1 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 900; font-size: clamp(56px, 6.5vw, 88px);
    line-height: 0.95; color: var(--ink); letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  .hero-sub {
    font-size: 15px; line-height: 1.75; color: var(--gray);
    max-width: 460px; margin-bottom: 32px;
  }
  .hero-cta-row { display: flex; gap: 10px; margin-bottom: 28px; }
  .hero-pills { display: flex; flex-wrap: wrap; gap: 7px; }

  /* ── PROGRAM SECTION ────────────────────────────────────────── */
  .prog-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: center;
  }
  .prog-map {
    background: var(--navy);
    aspect-ratio: 1 / 1;
    padding: 36px 32px;
    display: flex; flex-direction: column;
    justify-content: center;
    position: relative; overflow: hidden;
  }
  .prog-map-label {
    font-family: 'Pixelify Sans', sans-serif; font-size: 20px;
    color: rgba(139,163,194,0.7); letter-spacing: 0.12em;
    text-transform: uppercase; margin-bottom: 20px;
    text-align: center;
  }
  .prog-map img { width: 100%; height: auto; display: block; margin: 0 auto; }

  /* ── PROOF SECTION ───────────────────────────────────────────── */
  .proof-list { display: flex; flex-direction: column; gap: 16px; }
  .proof-card {
    border: 1.5px solid var(--soft);
    display: grid; grid-template-columns: 280px 1fr;
    gap: 48px; padding: 40px 48px;
    align-items: start;
  }
  .proof-card-left { display: flex; flex-direction: column; gap: 10px; }
  .proof-loc {
    font-family: 'Pixelify Sans', sans-serif; font-size: 14px;
    letter-spacing: 0.1em; color: var(--red); text-transform: uppercase;
  }
  .proof-title {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 700; font-size: 28px; color: var(--ink);
    line-height: 1.05; letter-spacing: -0.01em;
  }
  .proof-body { font-size: 16px; line-height: 1.75; color: var(--gray); }

  /* ── RESPONSIVE ──────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; height: auto; min-height: unset; }
    .hero-content { padding: 52px 48px 56px; }
    .hero-visual { height: 400px; }
    .prog-grid { grid-template-columns: 1fr; gap: 48px; }
    .prog-map { aspect-ratio: auto; padding: 32px; }
  }

  @media (max-width: 768px) {
    .hero-content { padding: 44px 20px 48px; }
    .hero-visual { height: 280px; }
    .hero-cta-row { flex-wrap: wrap; }
    .proof-card { grid-template-columns: 1fr; gap: 12px; padding: 28px 20px; }
  }

  @media (max-width: 480px) {
    .hero-visual { height: 240px; }
    .hero-cta-row { flex-direction: column; }
    .btn-primary, .btn-outline { text-align: center; width: 100%; }
  }
</style>
{% endblock %}

{% block content %}

<!-- HERO -->
<div class="hero">
  <div class="hero-content">
    <h1 class="hero-h1">Game&#8209;Based Civic Education for California&nbsp;K–12</h1>
    <p class="hero-sub">
      A statewide civics and esports initiative where K–12 students redesign their communities inside Minecraft Education — then pitch their solutions to the real leaders making decisions in their counties.
    </p>
    <div class="hero-cta-row">
      <a href="#competition" class="btn-primary">Explore the Competition</a>
      <a href="#program" class="btn-outline">How It Works</a>
    </div>
    <div class="hero-pills">
      <a href="/battle/" class="pill">For Students →</a>
      <a href="/educators/" class="pill">For Educators →</a>
      <a href="/partners/" class="pill">For Counties →</a>
      <a href="/partners/" class="pill">For Sponsors →</a>
    </div>
  </div>
  <div class="hero-visual">
    <img src="/assets/hero-image.png" alt="Level Up Civics students competing">
  </div>
</div>

<!-- DATE TICKER -->
<div class="ticker">
  <div class="ticker-lbl">Key Dates</div>
  <div class="ticker-items">
    <div class="ticker-event"><span class="ticker-date">SEPT 22</span><span class="ticker-name">World goes live</span></div>
    <div class="ticker-event"><span class="ticker-date">NOV 15</span><span class="ticker-name">Submissions close</span></div>
    <div class="ticker-event"><span class="ticker-date">DEC 4–5</span><span class="ticker-name">County Finals</span></div>
    <div class="ticker-event"><span class="ticker-date">JAN 9, 2027</span><span class="ticker-name">Statewide Championship</span></div>
  </div>
</div>

<!-- SCHOOLS REINVENTING COUNTIES -->
<section id="program" class="sec sec-cream">
  <div class="prog-grid">
    <div>
      <h2 class="sec-h2 sec-h2-dark page-h2 h2-body">Schools<br>Reinventing<br>Counties</h2>
      <p class="sec-body">
        A live Minecraft Education world covering the state of California. Students explore a digital map of their county, investigate a real local challenge — housing, transportation, sustainability — and design a solution.
      </p>
      <p class="sec-body">
        Teams of four work with their teacher to build and document their solution, then enter the Battle of the Counties. No prior game experience required. The worlds come built. The thinking is up to your students.
      </p>
      <a href="/program/" class="btn-primary" style="margin-top: 12px;">Explore the Program →</a>
    </div>
    <div class="prog-map">
      <div class="prog-map-label">4 Active Counties</div>
      <img src="/assets/california-map.svg" alt="California county map">
    </div>
  </div>
</section>

<!-- THREE PILLARS -->
<section class="sec sec-navy">
  <h2 class="sec-h2 sec-h2-light page-h2 h2-block">Three Pillars,<br>One Program</h2>
  <div class="grid-3">
    <div class="pillar">
      <div class="pillar-num">01</div>
      <h3 class="pillar-title">STEM & Digital Literacy</h3>
      <p class="pillar-body">Spatial reasoning, coding logic, and engineering design in a native digital environment. Students think like engineers while building real solutions.</p>
    </div>
    <div class="pillar">
      <div class="pillar-num">02</div>
      <h3 class="pillar-title">Civic Engagement</h3>
      <p class="pillar-body">Systems thinking, community problem-solving, and public policy exploration through authentic local challenges and real decision-makers.</p>
    </div>
    <div class="pillar">
      <div class="pillar-num">03</div>
      <h3 class="pillar-title">Academic Esports</h3>
      <p class="pillar-body">Real-time collaboration, consensus-building, and high-stakes presentation skills — in a competitive format that students actually want to win.</p>
    </div>
  </div>
</section>

<!-- BATTLE OF THE COUNTIES -->
<section id="competition" class="sec sec-cream">
  <div class="sec-header">
    <h2 class="sec-h2 sec-h2-dark page-h2">Battle of<br>the Counties</h2>
    <p class="sec-header-intro">A three-round statewide civics and esports competition. The best teams from each county advance toward a live championship — and the chance to pitch their ideas to the leaders who can act on them.</p>
  </div>
  <div class="grid-3">
    <div class="card">
      <div class="card-eyebrow card-eyebrow-dark">Round 01</div>
      <h3 class="card-title">Virtual Qualifiers</h3>
      <div class="card-badge">Opens Sept 22</div>
      <p class="card-body">Teams build a solution to a real community challenge and submit a video walkthrough. One team of four per school. Judges select top teams from each county to advance.</p>
    </div>
    <div class="card">
      <div class="card-eyebrow card-eyebrow-dark">Round 02</div>
      <h3 class="card-title">County Finals</h3>
      <div class="card-badge">Dec 4–5</div>
      <p class="card-body">Top teams compete live at their county office of education. Timed build events, presentations to judges and local civic leaders. Winners are crowned County Champions.</p>
    </div>
    <div class="card card-champ">
      <div class="card-eyebrow card-eyebrow-light">Round 03</div>
      <h3 class="card-title card-title-light">Statewide Championship</h3>
      <div class="card-badge card-badge-red">Jan 9, 2027</div>
      <p class="card-body card-body-light">County Champions face off at the Richard Nixon Presidential Library in Yorba Linda. Projects are presented to state educators, community leaders, and real decision-makers.</p>
    </div>
  </div>
</section>

<!-- PROOF POINTS -->
<section class="sec sec-cream" style="padding-top: 0;">
  <h2 class="sec-h2 sec-h2-dark page-h2 h2-block">This Model Works</h2>
  <div class="proof-list">
    <div class="proof-card">
      <div class="proof-card-left">
        <div class="proof-loc">Jacksonville, FL</div>
        <h3 class="proof-title">Riverfront Redesign</h3>
      </div>
      <p class="proof-body">Students redesigned a riverfront park during an actual city redesign. Their Minecraft builds were shared with urban planners and influenced real design conversations — going from game world to city council agenda.</p>
    </div>
    <div class="proof-card">
      <div class="proof-card-left">
        <div class="proof-loc">New York City</div>
        <h3 class="proof-title">Kingsbridge Armory</h3>
      </div>
      <p class="proof-body">Students reimagined a dormant 25+ year-old armory. High engagement through civic imagination, with students presenting their ideas directly at City Hall to real decision-makers.</p>
    </div>
    <div class="proof-card">
      <div class="proof-card-left">
        <div class="proof-loc">Calgary, Canada</div>
        <h3 class="proof-title">Accessible District</h3>
      </div>
      <p class="proof-body">Students partnered with an accessibility advocate to redesign an entertainment district for disabled community members — going from building in Minecraft to advocating in person.</p>
    </div>
  </div>
</section>

<!-- PARTNERS BAR -->
<div class="partners-bar">
  <div class="partners-lbl">In Partnership With</div>
  <div class="partners-names">
    <span class="partner">Orange County Dept. of Education</span>
    <span class="partner">San Bernardino COE</span>
    <span class="partner">Riverside COE</span>
    <span class="partner">Yolo COE</span>
    <span class="partner">Minecraft Education</span>
    <span class="partner">Lifeboat Studios</span>
  </div>
</div>

<!-- GET INVOLVED -->
<section class="sec sec-cream">
  <h2 class="sec-h2 sec-h2-dark page-h2 h2-block">There's a Role<br>for Everyone</h2>
  <div class="inv-grid">
    <a href="/battle/" class="card card-link">
      <div class="card-eyebrow card-eyebrow-dark">Students</div>
      <h3 class="card-title">Compete & Advocate</h3>
      <p class="card-body">Build a solution to a real challenge in your county. Form a team of four and represent your school in the Battle of the Counties.</p>
      <span class="card-link-text">Enter the competition →</span>
    </a>
    <a href="/educators/" class="card card-link">
      <div class="card-eyebrow card-eyebrow-dark">Educators</div>
      <h3 class="card-title">Pilot a Class</h3>
      <p class="card-body">No game experience required. The worlds come built, training is provided. You facilitate; your students do the advocating.</p>
      <span class="card-link-text">Get your school involved →</span>
    </a>
    <a href="/partners/" class="card card-link">
      <div class="card-eyebrow card-eyebrow-dark">Sponsors</div>
      <h3 class="card-title">Back the Program</h3>
      <p class="card-body">Sponsor a county, a region, or the championship. Visible civic investment with measurable outcomes in the communities you operate in.</p>
      <span class="card-link-text">Explore sponsorship →</span>
    </a>
    <a href="/partners/" class="card card-link">
      <div class="card-eyebrow card-eyebrow-dark">Counties &amp; Districts</div>
      <h3 class="card-title">Join the Initiative</h3>
      <p class="card-body">Bring Schools Reinventing Counties to your students. We handle the world build. Your schools bring the ideas.</p>
      <span class="card-link-text">Talk to us →</span>
    </a>
  </div>
</section>

{% endblock %}
